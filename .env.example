# 🌐 آدرس دائمی سرویس (برای Webhook — رندر/کویب خودش پر می‌کنه)
# BASE_URL=https://your-app.onrender.com
# USE_WEBHOOK=true

# ⚙️ بازه‌های زمانی (میلی‌ثانیه)
# PRICE_REFRESH_MS=60000      # به‌روزرسانی قیمت‌ها (پیش‌فرض: هر ۱ دقیقه)
# CHANNEL_POST_MS=900000      # پست خودکار به کانال (پیش‌فرض: هر ۱۵ دقیقه)
# ALERT_CHECK_MS=30000        # چک کردن هشدارها (پیش‌فرض: هر ۳۰ ثانیه)

# 🌐 پورت HTTP (برای پنل وب و سرویس‌های PaaS)
PORT=3000
