# 📢 یوزرنیم کانال شما (مثلاً @gold_dollar_channel)
CHANNEL_USERNAME=@gold_dollar_channel

# 🆔 آیدی عددی کانال (اختیاری — معمولاً با -100 شروع می‌شود)
# CHANNEL_ID=-1001234567890

# 🔐 آدرس کانال برای اجبار عضویت (اگر با CHANNEL_USERNAME فرق دارد)
