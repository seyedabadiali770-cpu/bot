# توکن ربات تلگرام — از @BotFather بگیر
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# آیدی عددی ادمین‌ها (با کاما جدا کنید) — اختیاری
ADMIN_IDS=318405928

# لیست سفید کاربران مجاز (اختیاری).
# اگر خالی باشد، همه می‌توانند از ربات استفاده کنند.
# اگر مقدار بدهید (با کاما جدا)، فقط همین آیدی‌ها اجازه‌ی استفاده دارند.
ALLOWED_IDS=

# --- تنظیمات روبیکا (اختیاری، برای دانلود از روبیکا) ---
RUBIKA_AUTH=
RUBIKA_PHONE=
RUBIKA_PASSWORD=

# حداکثر حجم مجاز برای ارسال فایل (مگابایت) — پیش‌فرض 49
MAX_FILE_SIZE_MB=49

# مدت اجرای ربات (ثانیه) — 0 یعنی همیشه روشن. برای GitHub Actions خودکار است.
MAX_RUNTIME_SECONDS=0
